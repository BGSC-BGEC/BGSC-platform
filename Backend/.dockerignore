# Dependency directories (container must run its own npm install)                                                                     
node_modules/                                                                                                                         
npm-debug.log*                                                                                                                        
yarn-debug.log*                                                                                                                       
yarn-error.log*                                                                                                                       
pnpm-debug.log*                                                                                                                       
                                                                                                                                          
# Build and compilation outputs                                                                                                       
dist/                                                                                                                                 
build/                                                                                                                                
# Must be **/ — a bare *.tsbuildinfo only matches the root directory, and a stale nested one makes
# `tsc --build` declare a project up to date, emit no dist/, and fail everything that imports it.
**/*.tsbuildinfo                                                                                                                         
                                                                                                                                      
# Environment & Secrets (Never bake actual secrets into images)                                                                       
.env                                                                                                                                  
.env.*                                                                                                                                
!.env.example                                                                                                                         
                                                                                                                                      
# Version Control                                                                                                                     
.git/                                                                                                                                 
.gitignore                                                                                                                            
.github/                                                                                                                              
                                                                                                                                      
# Testing & Coverage                                                                                                                  
test/                                                                                                                                 
tests/                                                                                                                                
coverage/                                                                                                                             
*.spec.ts
*.test.ts

# Logs
logs/
*.log

# IDE & Editor files
.idea/
.vscode/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Workspace build outputs (the image builds its own)
packages/*/dist/
apps/*/dist/
packages/*/node_modules/
apps/*/node_modules/

# Local upload storage — never bake user files into an image
uploads/
