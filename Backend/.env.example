# Application
PORT=3001
NODE_ENV=development

# MongoDB Connection
MONGO_URI=mongodb://bgsc_admin:bgsc_password@localhost:27017/bgsc_dev?authSource=admin

# Base URLs (Centralized - No hardcoded links)
API_BASE_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# JWT Authentication
JWT_ACCESS_SECRET=bgsc_dev_super_secret_access_key_change_in_production
JWT_REFRESH_SECRET=bgsc_dev_super_secret_refresh_key_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth2 (Co-located on same server)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:8081
INTERNAL_API_TOKEN=dev_internal_token_change_me
