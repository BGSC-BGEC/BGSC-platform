# Copy to .env before running anything:  cp .env.example .env
#
# These values are the LOCAL (host) setup: `npm run dev` per service, infrastructure in Docker.
# `docker compose up` overrides the URLs with container names — see docker-compose.yml. Compose
# reads the three secrets (refusing to start without them) and MONGO_ROOT_PASSWORD / REDIS_PASSWORD
# (falling back to the dev values below, which the production boot guard refuses).

NODE_ENV=development

# Each service picks its own port from its start script (auth 3001, user 3002, registration 3004);
# the gateway uses GATEWAY_PORT below. Set PORT only to run one service somewhere else, e.g.
#   PORT=3099 npm start --workspace @bgsc/user-service
# PORT=

# Base URLs (Centralized - No hardcoded links)
API_BASE_URL=http://localhost:3000   # the gateway: the only port published
FRONTEND_URL=http://localhost:5173   # the web app, not the API

# JWT Authentication
# ---- secrets (required by docker compose; change them for anything real) ----
JWT_ACCESS_SECRET=bgsc_dev_super_secret_access_key_change_in_production
JWT_REFRESH_SECRET=bgsc_dev_super_secret_refresh_key_change_in_production
# Guards /internal/* service-to-service routes AND signs every event-bus message (HMAC-SHA256), so
# every service must share the same value. The API refuses to boot in production while this is
# still the dev default.
INTERNAL_API_TOKEN=dev_internal_token_change_me
# Rotating it: put the old value here, the new one above, and restart EVERY service at once. The
# old key is then accepted (bus messages in flight, /internal calls from a not-yet-restarted
# service), never used for signing. Clear it once every service runs on the new value.
# INTERNAL_API_TOKEN_PREVIOUS=

# `npm run seed:founder` promotes this registered, active account to founder — once. It refuses if the
# account does not exist, is not active, or a different founder already exists.
FOUNDER_EMAIL=

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth2 (Co-located on same server)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Strava account linking (Spec §9.1). A connection, not a login method.
# Blank = every /strava route answers 503 strava_not_configured, which is the state this repo
# ships in: no Strava application is registered. Create one at strava.com/settings/api and set
# the Authorization Callback Domain to the host in STRAVA_CALLBACK_URL below.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_CALLBACK_URL=http://localhost:3000/strava/callback
# 64 hex chars (openssl rand -hex 32). Encrypts the stored Strava tokens at rest. Blank is
# tolerated in development (derived from JWT_ACCESS_SECRET) and refused at boot in production.
STRAVA_TOKEN_ENCRYPTION_KEY=

# WhatsApp Business (Cloud) API — announcement broadcast (Spec §9.4).
# Blank = every dispatch row resolves 'skipped / not_configured' and nothing is sent, which is the
# state this repo ships in: no WhatsApp Business account is registered. Note the Cloud API sends to
# phone numbers, not to WhatsApp groups, so a destination is
# whatever the configured provider addresses.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
# Graph API host. Override for a regional endpoint or an egress proxy; default is Meta's.
WHATSAPP_API_BASE=https://graph.facebook.com
# JSON, announcement category -> destination. Malformed JSON is a boot error, not a silent skip.
# e.g. {"bgec":"918000000000","fitsoc":"918000000001"}
WHATSAPP_GROUP_MAP=
# Spec §9.4: one announcement per tag per hour.
WHATSAPP_RATE_LIMIT_PER_HOUR=1

# ---- infrastructure ----
# Host addresses. In compose these become mongodb:27017 and redis:6379; both are published on
# 127.0.0.1 only. Production refuses to boot with the dev passwords below or a password-less Redis.
# MONGO_ROOT_PASSWORD only applies when the Mongo volume is first created, and is pasted into the
# Mongo URI, so keep it URL-safe. REDIS_PASSWORD travels on its own and may contain anything.
MONGO_ROOT_PASSWORD=bgsc_password
MONGO_URI=mongodb://bgsc_admin:bgsc_password@localhost:27017/bgsc_dev?authSource=admin
REDIS_PASSWORD=dev_redis_password_change_me
# Cross-process domain event bus. Blank = events stay in-process (fine when running one service).
# Host/port/db only — the password comes from REDIS_PASSWORD above (compose starts Redis with
# --requirepass). A password in the URL still works but loses to REDIS_PASSWORD.
REDIS_URL=redis://localhost:6379

# Where uploaded files are written, and what media-service serves as /uploads. Blank = Backend/uploads
# on the host; compose sets /app/uploads (one shared volume).
# UPLOAD_DIR=

# ---- who may call the gateway ----
# The frontends, not the gateway itself. Vite dev server and Expo. Required by docker compose.
CORS_ORIGIN=http://localhost:5173,http://localhost:8081

# ---- service topology ----
# Gateway is the only public entry point; everything else is reachable through it.
# Ports are ordered by the week each service was built. All twelve are live.
GATEWAY_PORT=3000

AUTH_SERVICE_URL=http://localhost:3001          # BE-1 · Week 1
USER_SERVICE_URL=http://localhost:3002          # BE-2 · Week 1
EVENT_SERVICE_URL=http://localhost:3003         # BE-1 · Week 2
REGISTRATION_SERVICE_URL=http://localhost:3004  # BE-2 · Week 2
ANNOUNCEMENT_SERVICE_URL=http://localhost:3005  # BE-2 · Week 2
POINTS_SERVICE_URL=http://localhost:3006        # BE-2 · Week 3
LEADERBOARD_SERVICE_URL=http://localhost:3007   # BE-1 · Week 3
CHALLENGE_SERVICE_URL=http://localhost:3008     # BE-2 · Week 3  (also serves /strava)
MEDIA_SERVICE_URL=http://localhost:3009         # BE-1 · Week 4
NOTIFICATION_SERVICE_URL=http://localhost:3010  # BE-2 · Week 4
FEEDBACK_SERVICE_URL=http://localhost:3011     # BE-2 · Week 4
BRACKET_SERVICE_URL=http://localhost:3012      # BE-2 · Week 4

# PORT is set per service by its own process (or by compose). Do not set it globally —
# every service would try to bind the same port.
