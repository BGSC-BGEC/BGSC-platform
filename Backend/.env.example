# Copy to .env before running anything:  cp .env.example .env
#
# These values are the LOCAL (host) setup: `npm run dev` per service, infrastructure in Docker.
# `docker compose up` overrides the URLs with container names — see docker-compose.yml. The only
# values compose reads from this file are the three secrets, which it refuses to start without.

NODE_ENV=development

# ---- secrets (required by docker compose; change them for anything real) ----
JWT_ACCESS_SECRET=bgsc_dev_super_secret_access_key_change_in_production
JWT_REFRESH_SECRET=bgsc_dev_super_secret_refresh_key_change_in_production
# Guards /internal/* service-to-service routes. The API refuses to boot in production
# while this is still the dev default.
INTERNAL_API_TOKEN=dev_internal_token_change_me

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---- infrastructure ----
# Host addresses. In compose these become mongodb:27017 and redis:6379.
MONGO_URI=mongodb://bgsc_admin:bgsc_password@localhost:27017/bgsc_dev?authSource=admin
# Cross-process domain event bus. Blank = events stay in-process (fine when running one service).
REDIS_URL=redis://localhost:6379

# ---- who may call the gateway ----
# The frontends, not the gateway itself. Vite dev server and Expo.
CORS_ORIGIN=http://localhost:5173,http://localhost:8081

# ---- service topology ----
# Gateway is the only public entry point; everything else is reachable through it.
# Ports are ordered by the week each service is built. Services marked (unbuilt) answer
# 503 through the gateway with their owner and week until they exist.
GATEWAY_PORT=3000

AUTH_SERVICE_URL=http://localhost:3001          # BE-1 · Week 1
USER_SERVICE_URL=http://localhost:3002          # BE-2 · Week 1
EVENT_SERVICE_URL=http://localhost:3003         # BE-1 · Week 2 (unbuilt)
REGISTRATION_SERVICE_URL=http://localhost:3004  # BE-2 · Week 2 (unbuilt)
ANNOUNCEMENT_SERVICE_URL=http://localhost:3005  # BE-2 · Week 2 (unbuilt)
POINTS_SERVICE_URL=http://localhost:3006        # BE-2 · Week 3 (unbuilt)
LEADERBOARD_SERVICE_URL=http://localhost:3007   # BE-1 · Week 3 (unbuilt)
CHALLENGE_SERVICE_URL=http://localhost:3008     # BE-2 · Week 3 (unbuilt)
MEDIA_SERVICE_URL=http://localhost:3009         # BE-1 · Week 4 (unbuilt)
NOTIFICATION_SERVICE_URL=http://localhost:3010  #        Week 4 (unbuilt)

# PORT is set per service by its own process (or by compose). Do not set it globally —
# every service would try to bind the same port.
