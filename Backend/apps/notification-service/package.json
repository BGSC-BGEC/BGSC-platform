{
  "name": "@bgsc/notification-service",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --watch src --watch ../../packages/shared/src --ext ts --exec ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "selfcheck": "ts-node src/selfcheck/broadcast.selfcheck.ts && ts-node src/selfcheck/dispatch.selfcheck.ts && ts-node src/selfcheck/inbox.selfcheck.ts",
    "e2e": "ts-node src/notifications/notification.e2e.ts"
  },
  "dependencies": {
    "@bgsc/shared": "1.0.0",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.5",
    "uuid": "^14.0.2",
    "zod": "^4.5.4"
  }
}
