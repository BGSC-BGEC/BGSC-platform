{
  "name": "@bgsc/registration-service",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --watch src --watch ../../packages/shared/src --ext ts --exec \"tsc -p ../../packages/shared && ts-node src/index.ts\"",
    "build": "tsc",
    "start": "node dist/index.js",
    "selfcheck": "ts-node src/selfcheck/forms.selfcheck.ts && ts-node src/selfcheck/registration.selfcheck.ts && ts-node src/selfcheck/teams.selfcheck.ts",
    "e2e": "ts-node src/registrations/registration.e2e.ts"
  },
  "dependencies": {
    "@bgsc/shared": "1.0.0",
    "express": "^5.2.1",
    "uuid": "^14.0.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "mongoose": "^9.9.5"
  }
}
