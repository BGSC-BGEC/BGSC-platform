{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": { "outDir": "./dist", "rootDir": "./src" },
    "references": [{ "path": "../../packages/shared" }],
    "include": ["src/**/*"],
    // The whole selfcheck/ tree is test-only, seed helpers included, so it is excluded
