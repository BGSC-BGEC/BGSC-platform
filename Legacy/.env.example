# ============================================================
# BGSC Platform — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# ============================================================

# ── Shared ──────────────────────────────────────────────────
NODE_ENV=development
POSTGRES_USER=bgsc
POSTGRES_DB=bgsc_dev

# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=CHANGE_ME_generate_with_openssl_rand_hex_32

# Generate with: openssl rand -hex 32
REDIS_PASSWORD=CHANGE_ME_generate_with_openssl_rand_hex_32

# Shared JWT secret — same value used by gateway + all services
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32

# Shared refresh secret — MUST differ from JWT_ACCESS_SECRET
# Generate with: openssl rand -hex 32
JWT_REFRESH_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32

JWT_ISSUER=bgsc-auth-service

# Service-to-service auth — used by Strava link, fan award, points award
# Generate with: openssl rand -hex 32
INTERNAL_SERVICE_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32

# ── Google OAuth ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://api.bgsc-platform.in/auth/google/callback
OAUTH_FRONTEND_CALLBACK_URL=https://bgsc-platform.in

# ── Strava OAuth ─────────────────────────────────────────────
STRAVA_CLIENT_ID=your_strava_client_id
STRAVA_CLIENT_SECRET=your_strava_client_secret
STRAVA_CALLBACK_URL=https://api.bgsc-platform.in/auth/strava/callback

# Generate with: openssl rand -base64 32
STRAVA_WEBHOOK_VERIFY_TOKEN=CHANGE_ME_generate_with_openssl_rand_base64_32

# Generate with: openssl rand -hex 32
STRAVA_TOKEN_ENCRYPTION_KEY=CHANGE_ME_generate_64_hex_chars

# ── TOTP ─────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
AUTH_TOTP_ENCRYPTION_KEY=CHANGE_ME_generate_64_hex_chars

# ── SMTP ─────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=noreply@bgsc-platform.in

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=https://bgsc-platform.in,https://www.bgsc-platform.in

# ── Rate limiting ────────────────────────────────────────────
RATE_LIMIT_GENERAL_MAX=100
RATE_LIMIT_GENERAL_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_AUTH_WINDOW_MS=900000

# ── Bcrypt ───────────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=12
